{
  "name": "qori-llm-gateway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "build:linux": "bun build src/index.js --compile --target=bun-linux-x64 --outfile=dist/qori-llm-gateway-x86_64-unknown-linux-gnu",
    "build:macos-arm64": "bun build src/index.js --compile --target=bun-darwin-arm64 --outfile=dist/qori-llm-gateway-aarch64-apple-darwin",
    "build:windows-x64": "bun build src/index.js --compile --target=bun-windows-x64 --outfile=dist/qori-llm-gateway-x86_64-pc-windows-msvc.exe"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.1"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
